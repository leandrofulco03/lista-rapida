# Cabeceras de seguridad que Cloudflare agrega a todas las respuestas.
# La app no tiene servidor: todo corre en el navegador y no se conecta a ningún otro sitio,
# así que se le permite cargar y conectarse sólo con su propio origen.
# vite.config.ts lee este archivo para aplicar las mismas cabeceras en `npm run preview`
# (y así las pruebas e2e corren con ellas).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), hid=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
