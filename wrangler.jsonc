// Publicación en Cloudflare (Workers con archivos estáticos). Cloudflare compila con `npm run build`
// (configurado en el panel) y esto sirve dist/; cualquier ruta desconocida va a la app.
{
  "name": "lista-match",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
