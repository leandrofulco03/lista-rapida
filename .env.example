# Copiá este archivo como .env.local y completá con los datos del proyecto de Supabase
# (Project Settings → API). La clave "anon" es pública: la seguridad la ponen las reglas (RLS).
# En Vercel, cargá las mismas dos variables en Settings → Environment Variables.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
